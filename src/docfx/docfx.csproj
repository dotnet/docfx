<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <RollForward>Major</RollForward>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Description>The docfx command line tool published as .NET tool</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../THIRD-PARTY-NOTICES.TXT" CopyToOutputDirectory="PreserveNewest" PackageCopyToOutput="true" />
  </ItemGroup>

  <!-- Keep one shared template directory instead of a copy for each tool framework. -->
  <Target Name="RewriteDocfxTemplateFiles" AfterTargets="PackTool">
    <PropertyGroup>
      <DocfxTemplateSourceTargetFramework>$(TargetFrameworks.Split(";")[0])</DocfxTemplateSourceTargetFramework>
    </PropertyGroup>
    <ItemGroup>
      <!-- Match source paths: the SDK may split the destination between PackagePath and RecursiveDir. -->
      <_DocfxTemplateFiles Include="$(PublishDir)templates/**/*" />
      <TfmSpecificPackageFile Remove="@(_DocfxTemplateFiles)" MatchOnMetadata="FullPath" MatchOnMetadataOptions="PathLike" />
    </ItemGroup>
    <Error Condition="'@(_DocfxTemplateFiles)' == ''" Text="No templates found to package. Run npm run build in the templates directory first." />
    <ItemGroup Condition="'$(TargetFramework)' == '$(DocfxTemplateSourceTargetFramework)'">
      <TfmSpecificPackageFile Include="@(_DocfxTemplateFiles)" PackagePath="templates/" />
    </ItemGroup>
  </Target>

  <!-- Tool packing also runs Publish targets; normal publishing must keep using adjacent templates. -->
  <ItemGroup Condition="'$(_IsPacking)' == 'true'">
    <RuntimeHostConfigurationOption Include="Docfx.DotnetToolMode" Value="true" />
  </ItemGroup>

  <!-- Refresh this switch even without building when alternating pack and publish. -->
  <Target Name="PrepareDocfxRuntimeConfiguration" BeforeTargets="ComputeFilesToPublish" DependsOnTargets="GenerateBuildRuntimeConfigurationFiles" />

  <ItemGroup>
    <InternalsVisibleTo Include="docfx.Snapshot.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Docfx.App\Docfx.App.csproj" />
    <ProjectReference Include="..\Docfx.Dotnet\Docfx.Dotnet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" />
  </ItemGroup>
</Project>
