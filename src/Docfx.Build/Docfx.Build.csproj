    <PackageReference Include="OneOf.SourceGenerator" PrivateAssets="All" />

    <Using Include="OneOf" />
    <Using Include="OneOf.OneOf&lt;bool, string&gt;" Alias="BoolOrString" />
    <Using Include="OneOf.OneOf&lt;string, string[]&gt;" Alias="StringOrArrayOfString" />
  </ItemGroup>

</Project>
